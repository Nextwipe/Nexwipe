[Unit]
Description=NexWipe stick visible section (org setup file and stick id)
DefaultDependencies=no
Before=nd-console.service

# Read-write so the stick can create its own id on first use. When booted without toram the live system already
# holds this section read-only; this mount then fails (nofail) and the station reads /run/live/medium instead.
[Mount]
What=/dev/disk/by-partlabel/NEXWIPE
Where=/run/nexwipe
Type=vfat
Options=rw,nosuid,nodev,noexec,noatime,flush,fmask=0177,dmask=0077,nofail,x-systemd.device-timeout=10s

[Install]
WantedBy=local-fs.target
